          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "anchor_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "clearance_m": {
          "maximum": 0.2,
          "minimum": 0,
          "type": "number"
        },
        "event_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "release_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "source_instance_ids": {
          "items": {
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
