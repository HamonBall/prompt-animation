          "enum": [
            1
          ]
        },
        "start_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "start_s",
        "end_s"
      ],
      "type": "object"
    }
  },
  "$id": "urn:avatar-animation:movement:v1:ContactEvent",
  "$ref": "#/$defs/ContactEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
