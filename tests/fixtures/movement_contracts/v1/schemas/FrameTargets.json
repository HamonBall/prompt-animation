{
  "$defs": {
    "ContactEvent": {
      "additionalProperties": false,
      "properties": {
        "acquire_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "anchor_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "clearance_m": {
          "maximum": 0.2,
          "minimum": 0,
          "type": "number"
        },
        "event_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "release_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "source_instance_ids": {
          "items": {
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "surface_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "source_instance_ids",
        "anchor_id",
        "surface_id",
        "interval",
        "acquire_s",
        "release_s",
        "clearance_m"
      ],
      "type": "object"
    },
    "ControlValue": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "frame": {
          "pattern": "(world|entry_body|current_root|current_torso|current_pelvis|joint:[A-Za-z0-9][A-Za-z0-9_.-]{0,95}|surface:[A-Za-z0-9][A-Za-z0-9_.-]{0,95})",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "unit": {
          "enum": [
            "degree",
            "metre",
            "avatar_height",
            "second",
            "unitless",
            "degree_per_second",
            "metre_per_second",
            "avatar_height_per_second"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "control_id",
        "unit",
        "frame",
        "value"
      ],
      "type": "object"
    },
    "FrameTargets": {
      "additionalProperties": false,
      "properties": {
        "active_contacts": {
          "items": {
            "$ref": "#/$defs/ContactEvent"
          },
          "maxItems": 256,
          "type": "array"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/ControlValue"
          },
          "maxItems": 256,
          "type": "array"
        },
        "expected_goals": {
          "items": {
            "$ref": "#/$defs/GoalSpec"
          },
          "maxItems": 256,
          "type": "array"
        },
        "permitted_supporting_changes": {
          "items": {
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "root_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "source_instance_ids": {
          "items": {
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "time_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "time_s",
        "controls",
        "active_contacts",
        "root_target",
        "source_instance_ids",
        "expected_goals",
        "permitted_supporting_changes"
      ],
      "type": "object"
    },
    "GoalSpec": {
      "additionalProperties": false,
      "properties": {
        "clause_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "goal_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "locked": {
          "type": "boolean"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "target": {
          "$ref": "#/$defs/ControlValue"
        },
        "tolerance": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "goal_id",
        "clause_id",
        "target",
        "interval",
        "tolerance",
        "locked"
      ],
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "start_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "start_s",
        "end_s"
      ],
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "pattern": "(world|entry_body|current_root|current_torso|current_pelvis|joint:[A-Za-z0-9][A-Za-z0-9_.-]{0,95}|surface:[A-Za-z0-9][A-Za-z0-9_.-]{0,95})",
          "type": "string"
        },
        "orientation": {
          "items": false,
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            }
          ],
          "type": "array"
        },
        "position": {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            }
          ],
          "type": "array"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "unit": {
          "enum": [
            "metre"
          ]
        }
      },
      "required": [
        "schema_version",
        "position",
        "orientation",
        "frame",
        "unit"
      ],
      "type": "object"
    }
  },
  "$id": "urn:avatar-animation:movement:v1:FrameTargets",
  "$ref": "#/$defs/FrameTargets",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
