{
  "$defs": {
    "ControlValue": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "frame": {
          "pattern": "(world|entry_body|current_root|current_torso|current_pelvis|joint:[A-Za-z0-9][A-Za-z0-9_.-]{0,95}|surface:[A-Za-z0-9][A-Za-z0-9_.-]{0,95})",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "unit": {
          "enum": [
            "degree",
            "metre",
            "avatar_height",
            "second",
            "unitless",
            "degree_per_second",
            "metre_per_second",
            "avatar_height_per_second"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "control_id",
        "unit",
        "frame",
        "value"
      ],
      "type": "object"
    },
