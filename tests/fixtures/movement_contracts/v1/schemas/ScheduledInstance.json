{
  "$defs": {
    "ScheduledInstance": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "schema_version": {
          "enum": [
            1
          ]
        }
      },
      "required": [
        "schema_version",
        "instance_id",
        "interval"
      ],
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "start_s": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "start_s",
        "end_s"
      ],
      "type": "object"
    }
  },
  "$id": "urn:avatar-animation:movement:v1:ScheduledInstance",
  "$ref": "#/$defs/ScheduledInstance",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
